# Database
# ENVIRONMENT=development downgrades the startup security checks to warnings
# and turns on /api/docs. Keep this "production" for any real deployment.
ENVIRONMENT=production
POSTGRES_USER=booruhub
POSTGRES_PASSWORD=change-me-db-password
POSTGRES_DB=booruhub
DATABASE_URL=postgresql+asyncpg://booruhub:change-me-db-password@db:5432/booruhub

# Cookies / docs
# Set COOKIE_SECURE=false when serving over plain HTTP (e.g. http://<ip>:8080 with no TLS),
# otherwise browsers drop the auth cookies and login appears broken.
COOKIE_SECURE=false
# Docs are off unless you opt in, regardless of ENVIRONMENT.
ENABLE_API_DOCS=false

# JWT (openssl rand -hex 32)
# Startup refuses to boot with the placeholder value below. Replace it.
JWT_SECRET=replace-with-a-random-64-char-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=15
# Seconds a just-rotated refresh token may be reused before it counts as a
# replay. Keeps two browser tabs refreshing at once from logging the user out.
REFRESH_REUSE_GRACE_SECONDS=30

# Encryption (python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
ENCRYPTION_KEY=replace-with-a-generated-fernet-key
ENCRYPTION_KEY_FALLBACKS=

# CORS
# Add the address you actually serve from. "*" is rejected at startup.
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
# Peers allowed to supply X-Real-IP / X-Forwarded-For for rate limiting. The
# bundled nginx shares a private Docker network with the backend and is
# trusted automatically; add explicit addresses only for other proxies.
TRUSTED_PROXY_IPS=127.0.0.1,::1

# Booru API Keys (optional)
DANBOORU_LOGIN=
DANBOORU_API_KEY=
E621_LOGIN=
E621_API_KEY=
RULE34_API_KEY=
RULE34_USER_ID=

# App
APP_PORT=8080
